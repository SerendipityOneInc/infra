# ------------------------------------------- Required block -----------------------------------------------------------
# These variables are required and don't have default values
# You must provide values for these to run the deployment successfully

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
# Azure region for all resources, e.g. centralus. Must be a region where the
# nested-virtualization-capable Firecracker host SKU (Standard_E32ads_v5) has
# capacity for your subscription — check with:
#   az vm list-skus --size Standard_E32ads_v5 --all \
#     --query "[?length(restrictions)==\`0\`].locationInfo[0].location" -o tsv
AZURE_LOCATION=centralus
# Resource group that holds the deployment (created by terraform if absent).
AZURE_RESOURCE_GROUP=e2b-dev

# your domain or subdomain name, eg great-innovations.dev, e2b.great-innovations.dev
DOMAIN_NAME=

# ------------------------------------------- Required with defaults ---------------------------------------------------
# These variables need to be specified but have default values

PROVIDER=azure
# prefix identifier for all resources
PREFIX=e2b-

# prod, staging, dev
TERRAFORM_ENVIRONMENT=dev

# Azure Container Registry name (registry becomes <ACR_NAME>.azurecr.io/<PREFIX>core).
# Must be globally unique, alphanumeric only.
ACR_NAME=

# Azure Blob Storage account backing object storage (templates, build cache,
# fc-env-pipeline binaries). The storage backend resolves credentials via
# Managed Identity (DefaultAzureCredential) unless AZURE_STORAGE_KEY /
# AZURE_STORAGE_CONNECTION_STRING is set. Consumed by the Go orchestrator as
# STORAGE_PROVIDER=AzureBucket + AZURE_STORAGE_ACCOUNT.
AZURE_STORAGE_ACCOUNT=

# ------------------------------------------- Optional block -----------------------------------------------------------
# Following variables are optional and doesn't have to be set

# Pull a released, prebuilt docker images from E2B's artifact
# registry instead of building it from source. When set, `make build-and-upload`
# pulls this version and mirrors it into your own core repo (caching it locally).
# Leave empty to build from source. Example: v0.1.0
DOCKER_REVERSE_PROXY_VERSION=
CLIENT_PROXY_VERSION=
CLICKHOUSE_MIGRATOR_VERSION=

# Object-storage auth override for local/dev without Managed Identity (Azurite,
# a storage-account key, or a full connection string). Leave empty in prod to
# use the VMSS user-assigned Managed Identity.
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONNECTION_STRING=

# Bring-your-own Postgres DSN (Azure Database for PostgreSQL Flexible Server over
# a Private Endpoint). Password auth; only the DSN changes vs GCP. Seeded into
# Key Vault by terraform and injected into the api/orchestrator Nomad jobs.
# POSTGRES_CONNECTION_STRING=

# Sandbox firewall: comma-separated CIDRs to allow through the private-range deny list
# ALLOW_SANDBOX_INTERNAL_CIDRS=
